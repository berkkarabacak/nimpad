<!--
    Base pieces: focus visuals, the window style, dividers, hyperlinks and tooltips.
    Focus (deck p-26): a 2 px Accent ring. Standalone controls get it OUTSIDE with a 2 px gap (FocusVisual*);
    rows, tabs and menu items get it INSIDE (InsetFocusVisual*). FocusVisualStyle only shows for keyboard focus.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:NimPad.App.Controls">

    <!-- Outside ring for radius-6 controls (buttons, inputs, dropdowns): 2 px gap + 2 px ring, radius 6 + 4. -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-4" BorderThickness="2" CornerRadius="10" SnapsToDevicePixels="True"
                            BorderBrush="{DynamicResource AccentBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Outside ring for radius-4 controls (link buttons, small icon buttons). -->
    <Style x:Key="FocusVisualSmall">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-4" BorderThickness="2" CornerRadius="8" SnapsToDevicePixels="True"
                            BorderBrush="{DynamicResource AccentBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Outside ring for fully rounded controls (switches, chips, pills, avatars). -->
    <Style x:Key="FocusVisualPill">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-4" BorderThickness="2" CornerRadius="999" SnapsToDevicePixels="True"
                            BorderBrush="{DynamicResource AccentBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Inside ring for rows and tabs (radius 6). -->
    <Style x:Key="InsetFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderThickness="2" CornerRadius="6" SnapsToDevicePixels="True"
                            BorderBrush="{DynamicResource AccentBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Inside ring for menu items and dropdown rows (radius 4). -->
    <Style x:Key="InsetFocusVisualSmall">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderThickness="2" CornerRadius="4" SnapsToDevicePixels="True"
                            BorderBrush="{DynamicResource AccentBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Keyed window style (implicit Window styles do not reach derived window classes):
        <Window ... Style="{DynamicResource AppWindow}">. Surface background, Text foreground, the UI font at Body
        size and layout rounding for crisp 1 px lines.
    -->
    <Style x:Key="AppWindow" TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Horizontal 1 px Line divider (card rows, panel sections). Also the implicit Separator style. -->
    <Style x:Key="Divider" TargetType="Separator">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="{DynamicResource LineBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Separator" BasedOn="{StaticResource Divider}" />

    <!-- Vertical 1 x 16 Sep line (between unselected tabs, status bar groups): <Border Style="..." />. -->
    <Style x:Key="VerticalDivider" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource SepBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Inline links in text: Accent, underline on hover. -->
    <Style TargetType="Hyperlink">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="TextDecorations" Value="{x:Null}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}" />
                <Setter Property="TextDecorations" Value="Underline" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Text3Brush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        Tooltip: a compact inverse chip ("Close (Ctrl+W)", deck p-25): Text-colored fill, Surface-colored caption
        text, radius 4, no shadow. Long text wraps at 320.
    -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Background" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}"
                            MaxWidth="320" SnapsToDevicePixels="True">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Setter Property="LineHeight" Value="16" />
                                    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
