<!--
    Surfaces (deck p-25): cards, flyouts, dialogs, toasts, banners, key caps, pills, avatar, spinner and loading
    placeholders. Card styles target ContentControl: <ContentControl Style="{StaticResource DialogCard}">...</ContentControl>.
    Elevated cards draw their shadow on a separate, static layer behind the content, so content changes never
    re-render the effect. Leave room around an elevated card for its shadow (about 16 px below, 8 px to the sides).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:NimPad.App.Controls">

    <!-- Flat card: Raised fill, 1 px Line border, radius 8, 16 px padding (settings groups, account card). -->
    <Style x:Key="Card" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="c:Ui.CornerRadius" Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding c:Ui.CornerRadius}" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Flyout card: Raised, radius 8, 1 px Line border, FlyoutShadow (find panel, popovers). Padding 12. -->
    <Style x:Key="FlyoutCard" TargetType="ContentControl" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid SnapsToDevicePixels="True">
                        <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding c:Ui.CornerRadius}"
                                Effect="{DynamicResource FlyoutShadow}" />
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding c:Ui.CornerRadius}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dialog card: Raised, radius 8, DialogShadow, 24 px padding. Put it over a ScrimBrush-filled layer. -->
    <Style x:Key="DialogCard" TargetType="ContentControl" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="24" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid SnapsToDevicePixels="True">
                        <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding c:Ui.CornerRadius}"
                                Effect="{DynamicResource DialogShadow}" />
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding c:Ui.CornerRadius}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toast card: a flyout card, 44 px minimum, 16 x 10 padding (message, action, KeyCap shortcut, close). -->
    <Style x:Key="ToastCard" TargetType="ContentControl" BasedOn="{StaticResource FlyoutCard}">
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="13.5" />
    </Style>

    <!-- Callout: a quiet Hover-filled note box, radius 6, 12 px padding, Text2 (tips inside panels). -->
    <Style x:Key="CalloutCard" TargetType="ContentControl" BasedOn="{StaticResource Card}">
        <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="c:Ui.CornerRadius" Value="6" />
    </Style>

    <!-- Empty-state badge: a 44 px Hover circle with a 20 px Text2 icon (c:Ui.Icon). -->
    <Style x:Key="IconBadge" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Ellipse Fill="{TemplateBinding Background}" />
                        <c:Icon Size="20" Data="{TemplateBinding c:Ui.Icon}" HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Status pill (ContentControl): 22 px, fully rounded, 12 / 600, optional c:Ui.Icon. Neutral by default;
        OkPill ("Connected"), AccentPill ("Newer"), WarnPill, ErrPill. Never color alone: keep the word.
    -->
    <Style x:Key="StatusPill" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Background="{TemplateBinding Background}" CornerRadius="11" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <c:Icon x:Name="Glyph" Size="14" Margin="0,0,4,0" VerticalAlignment="Center"
                                    StrokeThickness="1.5" Data="{TemplateBinding c:Ui.Icon}" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="c:Ui.Icon" Value="{x:Null}">
                            <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="OkPill" TargetType="ContentControl" BasedOn="{StaticResource StatusPill}">
        <Setter Property="Background" Value="{DynamicResource OkSoftBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OkBrush}" />
    </Style>
    <Style x:Key="AccentPill" TargetType="ContentControl" BasedOn="{StaticResource StatusPill}">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style x:Key="WarnPill" TargetType="ContentControl" BasedOn="{StaticResource StatusPill}">
        <Setter Property="Background" Value="{DynamicResource WarnSoftBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
    </Style>
    <Style x:Key="ErrPill" TargetType="ContentControl" BasedOn="{StaticResource StatusPill}">
        <Setter Property="Background" Value="{DynamicResource ErrSoftBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ErrBrush}" />
    </Style>

    <!--
        Banner (implicit for c:Banner): 36 px minimum, 12 x 8 padding, icon + wrapping message + one link action +
        optional dismiss. Info = Hover fill + Text2 icon; Warning = WarnSoft + Warn icon; Error = ErrSoft + Err icon.
    -->
    <Style TargetType="c:Banner">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:Banner">
                    <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                            MinHeight="{TemplateBinding MinHeight}" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <c:Icon x:Name="Glyph" Margin="0,2,10,0" VerticalAlignment="Top"
                                    Data="{TemplateBinding Icon}" Foreground="{DynamicResource Text2Brush}" />
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                        <Setter Property="LineHeight" Value="20" />
                                        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <Button x:Name="Action" Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center"
                                    Style="{DynamicResource LinkButton}" Content="{TemplateBinding ActionContent}"
                                    Command="{TemplateBinding ActionCommand}"
                                    CommandParameter="{TemplateBinding ActionCommandParameter}" />
                            <Button x:Name="Dismiss" Grid.Column="3" Margin="12,0,-4,0" VerticalAlignment="Center"
                                    Style="{DynamicResource SmallIconButton}" c:Ui.Icon="{DynamicResource Close}"
                                    Command="{TemplateBinding DismissCommand}"
                                    CommandParameter="{TemplateBinding DismissCommandParameter}"
                                    AutomationProperties.Name="Dismiss" ToolTip="Dismiss" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ActionContent" Value="{x:Null}">
                            <Setter TargetName="Action" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="DismissCommand" Value="{x:Null}">
                            <Setter TargetName="Dismiss" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Kind" Value="Warning">
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource WarnBrush}" />
                        </Trigger>
                        <Trigger Property="Kind" Value="Error">
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource ErrBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Icon" Value="{x:Null}" />
                                <Condition Property="Kind" Value="Info" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Glyph" Property="Data" Value="{DynamicResource Info}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Icon" Value="{x:Null}" />
                                <Condition Property="Kind" Value="Warning" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Glyph" Property="Data" Value="{DynamicResource Warning}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Icon" Value="{x:Null}" />
                                <Condition Property="Kind" Value="Error" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Glyph" Property="Data" Value="{DynamicResource ErrorCircle}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Kind" Value="Warning">
                <Setter Property="Background" Value="{DynamicResource WarnSoftBrush}" />
            </Trigger>
            <Trigger Property="Kind" Value="Error">
                <Setter Property="Background" Value="{DynamicResource ErrSoftBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="InfoBanner" TargetType="c:Banner" BasedOn="{StaticResource {x:Type c:Banner}}">
        <Setter Property="Kind" Value="Info" />
    </Style>
    <Style x:Key="WarningBanner" TargetType="c:Banner" BasedOn="{StaticResource {x:Type c:Banner}}">
        <Setter Property="Kind" Value="Warning" />
    </Style>
    <Style x:Key="ErrorBanner" TargetType="c:Banner" BasedOn="{StaticResource {x:Type c:Banner}}">
        <Setter Property="Kind" Value="Error" />
    </Style>

    <!-- Key cap (implicit for c:KeyCap): radius 4, Line2 border with a 2 px bottom edge, mono 12 px Text2. -->
    <Style TargetType="c:KeyCap">
        <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line2Brush}" />
        <Setter Property="BorderThickness" Value="1,1,1,2" />
        <Setter Property="FontFamily" Value="{DynamicResource EditorFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="MinWidth" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:KeyCap">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <TextBlock Text="{TemplateBinding Text}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A gesture as key caps 4 px apart (implicit for c:ShortcutKeys): <c:ShortcutKeys Gesture="Ctrl+Shift+T" />. -->
    <Style TargetType="c:ShortcutKeys">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:ShortcutKeys">
                    <ItemsControl Margin="0,0,-4,0" Focusable="False" IsTabStop="False"
                                  ItemsSource="{TemplateBinding Keys}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <c:KeyCap Margin="0,0,4,0" Text="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Avatar (implicit for c:Avatar): 28 px AvatarBg circle with 11 / 600 AvatarFg initials, or a photo; status dot
        (10 px, ringed in StatusRingBrush): Syncing = Accent, Offline = Text3, Conflict = Warn, Error = Err.
        For a larger avatar set Width/Height and FontSize together (64 px: FontSize 22).
    -->
    <Style TargetType="c:Avatar">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Background" Value="{DynamicResource AvatarBgBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AvatarFgBrush}" />
        <Setter Property="StatusRingBrush" Value="{DynamicResource ChromeBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:Avatar">
                    <Grid>
                        <Ellipse Fill="{TemplateBinding Background}" />
                        <TextBlock x:Name="Initials" Text="{TemplateBinding Initials}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        <Ellipse x:Name="Photo">
                            <Ellipse.Fill>
                                <ImageBrush Stretch="UniformToFill"
                                            ImageSource="{Binding Source, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse x:Name="Dot" Width="10" Height="10" Margin="0,0,-2,-2" HorizontalAlignment="Right"
                                 VerticalAlignment="Bottom" StrokeThickness="2" Visibility="Collapsed"
                                 Stroke="{TemplateBinding StatusRingBrush}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Source" Value="{x:Null}">
                            <Setter TargetName="Photo" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Status" Value="Syncing">
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="Status" Value="Offline">
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Text3Brush}" />
                        </Trigger>
                        <Trigger Property="Status" Value="Conflict">
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource WarnBrush}" />
                        </Trigger>
                        <Trigger Property="Status" Value="Error">
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource ErrBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Spinner (implicit): Accent by default; inside busy buttons set Foreground to the button text color. -->
    <Style TargetType="c:Spinner">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Focusable" Value="False" />
    </Style>

    <!-- Skeleton line (implicit): a 12 px Hover-filled bar; set Width to the text it stands in for. -->
    <Style TargetType="c:SkeletonLine">
        <Setter Property="Fill" Value="{DynamicResource HoverBrush}" />
        <Setter Property="Height" Value="12" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

</ResourceDictionary>
