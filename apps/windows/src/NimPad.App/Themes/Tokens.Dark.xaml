<!--
    NimPad design tokens: DARK theme.
    Values from docs/design/tokens.md (the source of truth). Change both token files together;
    NimPad.App.Tests/Themes/TokenTests.cs checks every value against a copy of its tables.
    Every token has a Color ("<Name>Color") and a frozen SolidColorBrush ("<Name>Brush").
    Translucent tokens are ARGB: alpha = round(opacity * 255), e.g. #1D1D1B at 6% = #0F1D1D1B.
    ThemeService keeps this dictionary FIRST in Application.Resources.MergedDictionaries and swaps it
    with the other theme, so consumers must always use {DynamicResource ...} for these keys.
-->
<ResourceDictionary x:Class="NimPad.App.Themes.TokensDark"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    mc:Ignorable="po">

    <!-- Marker: which token set this is ("Light" or "Dark"). -->
    <sys:String x:Key="ThemeName">Dark</sys:String>

    <!-- Colors -->
    <Color x:Key="ChromeColor">#FF252527</Color> <!-- #252527 -->
    <Color x:Key="SurfaceColor">#FF1B1B1D</Color> <!-- #1B1B1D -->
    <Color x:Key="RaisedColor">#FF2B2B2E</Color> <!-- #2B2B2E -->
    <Color x:Key="TextColor">#FFE8E7E3</Color> <!-- #E8E7E3 -->
    <Color x:Key="Text2Color">#FFA8A7A2</Color> <!-- #A8A7A2 -->
    <Color x:Key="Text3Color">#FF92918C</Color> <!-- #92918C -->
    <Color x:Key="HoverColor">#12FFFFFF</Color> <!-- #FFFFFF · 7% -->
    <Color x:Key="PressColor">#1CFFFFFF</Color> <!-- #FFFFFF · 11% -->
    <Color x:Key="SepColor">#29FFFFFF</Color> <!-- #FFFFFF · 16% -->
    <Color x:Key="LineColor">#17FFFFFF</Color> <!-- #FFFFFF · 9% -->
    <Color x:Key="Line2Color">#38FFFFFF</Color> <!-- #FFFFFF · 22% -->
    <Color x:Key="AccentColor">#FF8CA2FF</Color> <!-- #8CA2FF -->
    <Color x:Key="AccentHoverColor">#FFA3B5FF</Color> <!-- #A3B5FF -->
    <Color x:Key="AccentPressedColor">#FF7389EA</Color> <!-- #7389EA -->
    <Color x:Key="AccentSoftColor">#298CA2FF</Color> <!-- #8CA2FF · 16% -->
    <Color x:Key="OnAccentColor">#FF0B1230</Color> <!-- #0B1230 -->
    <Color x:Key="SelectionColor">#4D8CA2FF</Color> <!-- #8CA2FF · 30% -->
    <Color x:Key="CurrentLineColor">#0AFFFFFF</Color> <!-- #FFFFFF · 4% -->
    <Color x:Key="MatchColor">#57F0BE3C</Color> <!-- #F0BE3C · 34% -->
    <Color x:Key="MatchCurrentColor">#99F0A028</Color> <!-- #F0A028 · 60% -->
    <Color x:Key="AvatarBgColor">#FF33406F</Color> <!-- #33406F -->
    <Color x:Key="AvatarFgColor">#FFD5DEFF</Color> <!-- #D5DEFF -->
    <Color x:Key="OkColor">#FF6FCB95</Color> <!-- #6FCB95 -->
    <Color x:Key="OkSoftColor">#246FCB95</Color> <!-- #6FCB95 · 14% -->
    <Color x:Key="WarnColor">#FFEDB75A</Color> <!-- #EDB75A -->
    <Color x:Key="WarnSoftColor">#24EDB75A</Color> <!-- #EDB75A · 14% -->
    <Color x:Key="ErrColor">#FFFF8F86</Color> <!-- #FF8F86 -->
    <Color x:Key="ErrSoftColor">#24FF8F86</Color> <!-- #FF8F86 · 14% -->
    <Color x:Key="DiffAddColor">#2E5AC882</Color> <!-- #5AC882 · 18% -->
    <Color x:Key="DiffDelColor">#2EFF6E64</Color> <!-- #FF6E64 · 18% -->
    <Color x:Key="SyntaxKeyColor">#FF8DB4FF</Color> <!-- #8DB4FF -->
    <Color x:Key="SyntaxStringColor">#FF8FD1A5</Color> <!-- #8FD1A5 -->
    <Color x:Key="SyntaxNumberColor">#FFF0B27A</Color> <!-- #F0B27A -->
    <Color x:Key="SyntaxLiteralColor">#FFC9A0F0</Color> <!-- #C9A0F0 -->
    <Color x:Key="SyntaxPunctuationColor">#FF8D8C87</Color> <!-- #8D8C87 -->
    <Color x:Key="SyntaxCommentColor">#FF8A8984</Color> <!-- #8A8984 -->
    <Color x:Key="CloseHoverColor">#FFC42B1C</Color> <!-- #C42B1C -->
    <Color x:Key="ScrimColor">#8C000000</Color> <!-- #000000 · 55% -->

    <!-- Brushes (frozen) -->
    <SolidColorBrush x:Key="ChromeBrush" Color="{StaticResource ChromeColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="RaisedBrush" Color="{StaticResource RaisedColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="Text2Brush" Color="{StaticResource Text2Color}" po:Freeze="True" />
    <SolidColorBrush x:Key="Text3Brush" Color="{StaticResource Text3Color}" po:Freeze="True" />
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="PressBrush" Color="{StaticResource PressColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="SepBrush" Color="{StaticResource SepColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="Line2Brush" Color="{StaticResource Line2Color}" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource SelectionColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="CurrentLineBrush" Color="{StaticResource CurrentLineColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="MatchBrush" Color="{StaticResource MatchColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="MatchCurrentBrush" Color="{StaticResource MatchCurrentColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="AvatarBgBrush" Color="{StaticResource AvatarBgColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="AvatarFgBrush" Color="{StaticResource AvatarFgColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="OkBrush" Color="{StaticResource OkColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="OkSoftBrush" Color="{StaticResource OkSoftColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="WarnSoftBrush" Color="{StaticResource WarnSoftColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="ErrBrush" Color="{StaticResource ErrColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="ErrSoftBrush" Color="{StaticResource ErrSoftColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="DiffAddBrush" Color="{StaticResource DiffAddColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="DiffDelBrush" Color="{StaticResource DiffDelColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="SyntaxKeyBrush" Color="{StaticResource SyntaxKeyColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="SyntaxStringBrush" Color="{StaticResource SyntaxStringColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="SyntaxNumberBrush" Color="{StaticResource SyntaxNumberColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="SyntaxLiteralBrush" Color="{StaticResource SyntaxLiteralColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="SyntaxPunctuationBrush" Color="{StaticResource SyntaxPunctuationColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="SyntaxCommentBrush" Color="{StaticResource SyntaxCommentColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="CloseHoverBrush" Color="{StaticResource CloseHoverColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{StaticResource ScrimColor}" po:Freeze="True" />

</ResourceDictionary>
