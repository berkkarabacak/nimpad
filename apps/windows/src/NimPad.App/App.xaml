<Application x:Class="NimPad.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:themes="clr-namespace:NimPad.App.Themes"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Design tokens: MUST stay first; ThemeService swaps this entry for TokensDark / TokensLight. -->
                <themes:TokensLight />
                <!-- Typography, metrics, icons and control styles (see Themes/README.md). -->
                <themes:DesignSystem />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
