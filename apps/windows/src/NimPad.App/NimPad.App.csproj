<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Windows desktop application (WPF + AvalonEdit). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>NimPad</AssemblyName>
    <RootNamespace>NimPad.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\NimPad.Presentation\NimPad.Presentation.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="AvalonEdit" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="NimPad.App.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- NimPad's own syntax definitions (YAML, Groovy, INI); see Highlighting/README.md. -->
    <EmbeddedResource Include="Highlighting\Definitions\*.xshd" LogicalName="NimPad.App.Highlighting.Definitions.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
