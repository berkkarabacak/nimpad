<!--
    The Settings window (deck pages 18 and 21, keyboard behavior from page 27): its own small window with the standard
    Windows frame (dark when the theme is dark), a 216 px section list on the left and the selected page on the right.
    Phase 1 shows Appearance and General; Account and Synchronization arrive with sign-in in Phase 2, and "Minimize to
    system tray" is deferred. Every control applies live through SettingsViewModel (the DataContext).
    Only DynamicResource is used for design-system keys, so the window also works where the design system is merged
    after construction (the tests install it into the window's own resources).
-->
<Window x:Class="NimPad.App.Views.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:NimPad.App.Controls"
        xmlns:v="clr-namespace:NimPad.App.Views.Settings"
        xmlns:vm="clr-namespace:NimPad.Presentation.Settings;assembly=NimPad.Presentation"
        xmlns:domain="clr-namespace:NimPad.Core.Domain;assembly=NimPad.Core"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="Settings" Width="760" Height="600" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{DynamicResource AppWindow}"
        AutomationProperties.AutomationId="SettingsWindow">
    <Window.Resources>
        <!-- Measured on pages 18 and 21 (rendered at about 1.15x; the 216 px section list is the reference): rows are
             at least 56 px (36 + 2 x 10) with 16 px side padding, the page has a 32 x 24 margin, label and control are
             at least 16 px apart, and the window is sized so the Appearance page fits without scrolling. -->
        <Thickness x:Key="SettingsPageMargin">32,24,32,24</Thickness>
        <Thickness x:Key="SettingsRowPadding">16,10,16,10</Thickness>
        <Thickness x:Key="SettingsRowDivider">0,1,0,0</Thickness>
        <Thickness x:Key="SettingsControlGap">16,0,0,0</Thickness>
        <sys:Double x:Key="SettingsRowMinHeight">36</sys:Double>
        <sys:Double x:Key="SettingsDropdownWidth">240</sys:Double>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sections. Up/Down move between them; the selected one has the 3 px accent bar (NavItem). -->
        <Border Width="{DynamicResource SettingsNavWidth}" Background="{DynamicResource ChromeBrush}">
            <ListBox x:Name="Nav" Margin="12" Background="Transparent"
                     ItemContainerStyle="{DynamicResource NavItem}"
                     SelectedValuePath="Tag" SelectedValue="{Binding SelectedPage}"
                     SelectionChanged="OnSectionChanged"
                     AutomationProperties.AutomationId="SettingsNav" AutomationProperties.Name="Settings sections">
                <ListBoxItem Content="Appearance" Tag="{x:Static vm:SettingsPage.Appearance}"
                             c:Ui.Icon="{DynamicResource Sun}"
                             AutomationProperties.AutomationId="SettingsNavAppearance" AutomationProperties.Name="Appearance" />
                <ListBoxItem Content="General" Tag="{x:Static vm:SettingsPage.General}"
                             c:Ui.Icon="{DynamicResource Sliders}"
                             AutomationProperties.AutomationId="SettingsNavGeneral" AutomationProperties.Name="General" />
            </ListBox>
        </Border>

        <ScrollViewer x:Name="PageScroller" Grid.Column="1" Background="{DynamicResource SurfaceBrush}"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <Grid Margin="{StaticResource SettingsPageMargin}">

                <!-- ============================================================ Appearance (page 18) -->
                <StackPanel x:Name="AppearancePage"
                            Visibility="{Binding SelectedPage, Converter={x:Static v:VisibleWhenEqualConverter.Instance}, ConverterParameter={x:Static vm:SettingsPage.Appearance}}">
                    <TextBlock Text="Appearance" Style="{DynamicResource PageTitleText}" Foreground="{DynamicResource TextBrush}" />

                    <!-- Live preview in the chosen font, size, wrap, line numbers and (through the app theme) colors. -->
                    <Border x:Name="Preview" Margin="0,16,0,0" Padding="20,16" CornerRadius="8" BorderThickness="1"
                            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                            AutomationProperties.AutomationId="SettingsPreview" AutomationProperties.Name="Preview">
                        <Grid ClipToBounds="True"
                              TextElement.FontFamily="{Binding EditorFontFamily}"
                              TextElement.FontSize="{Binding FontSize}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="1" Margin="0,0,16,0" TextAlignment="Right" Foreground="{DynamicResource Text3Brush}"
                                       Visibility="{Binding ShowLineNumbers, Converter={x:Static v:VisibleWhenConverter.Instance}}" />
                            <TextBlock Grid.Column="1" Text="{Binding PreviewLines[0]}" Foreground="{DynamicResource TextBrush}"
                                       TextWrapping="{Binding WordWrap, Converter={x:Static v:WrapConverter.Instance}}" />
                            <TextBlock Grid.Row="1" Text="2" Margin="0,0,16,0" TextAlignment="Right" Foreground="{DynamicResource Text3Brush}"
                                       Visibility="{Binding ShowLineNumbers, Converter={x:Static v:VisibleWhenConverter.Instance}}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PreviewLines[1]}" Foreground="{DynamicResource TextBrush}"
                                       TextWrapping="{Binding WordWrap, Converter={x:Static v:WrapConverter.Instance}}" />
                        </Grid>
                    </Border>

                    <ContentControl Style="{DynamicResource Card}" Padding="0" Margin="0,16,0,0">
                        <StackPanel>
                            <!-- Theme -->
                            <Grid MinHeight="{StaticResource SettingsRowMinHeight}" Margin="{StaticResource SettingsRowPadding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Theme" Style="{DynamicResource BodyLabelText}" Foreground="{DynamicResource TextBrush}" />
                                    <TextBlock Text="Follow Windows or pick one." Style="{DynamicResource SecondaryText}"
                                               Foreground="{DynamicResource Text2Brush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <c:SegmentedControl x:Name="ThemeSegmented" Grid.Column="1" Margin="{StaticResource SettingsControlGap}"
                                                    VerticalAlignment="Center"
                                                    SelectedValuePath="Tag" SelectedValue="{Binding Theme}"
                                                    AutomationProperties.AutomationId="ThemeSegmented" AutomationProperties.Name="Theme">
                                    <c:SegmentedControlItem Content="Light" Tag="{x:Static domain:ThemePreference.Light}" AutomationProperties.Name="Light" />
                                    <c:SegmentedControlItem Content="Dark" Tag="{x:Static domain:ThemePreference.Dark}" AutomationProperties.Name="Dark" />
                                    <c:SegmentedControlItem Content="System" Tag="{x:Static domain:ThemePreference.System}" AutomationProperties.Name="System" />
                                </c:SegmentedControl>
                            </Grid>

                            <!-- Editor font -->
                            <Border BorderThickness="{StaticResource SettingsRowDivider}" BorderBrush="{DynamicResource LineBrush}">
                                <Grid MinHeight="{StaticResource SettingsRowMinHeight}" Margin="{StaticResource SettingsRowPadding}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Editor font" VerticalAlignment="Center" Style="{DynamicResource BodyLabelText}"
                                               Foreground="{DynamicResource TextBrush}" />
                                    <ComboBox x:Name="FontDropdown" Grid.Column="1" Margin="{StaticResource SettingsControlGap}"
                                              Width="{StaticResource SettingsDropdownWidth}" VerticalAlignment="Center"
                                              ItemsSource="{Binding FontFamilies}" SelectedItem="{Binding EditorFontFamily}"
                                              AutomationProperties.AutomationId="FontDropdown" AutomationProperties.Name="Editor font" />
                                </Grid>
                            </Border>

                            <!-- Font size -->
                            <Border BorderThickness="{StaticResource SettingsRowDivider}" BorderBrush="{DynamicResource LineBrush}">
                                <Grid MinHeight="{StaticResource SettingsRowMinHeight}" Margin="{StaticResource SettingsRowPadding}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Font size" VerticalAlignment="Center" Style="{DynamicResource BodyLabelText}"
                                               Foreground="{DynamicResource TextBrush}" />
                                    <c:Stepper x:Name="FontSizeStepper" Grid.Column="1" Margin="{StaticResource SettingsControlGap}"
                                               VerticalAlignment="Center" Minimum="8" Maximum="32" Step="1" Suffix="px"
                                               Value="{Binding FontSize}"
                                               AutomationProperties.AutomationId="FontSizeStepper" AutomationProperties.Name="Font size" />
                                </Grid>
                            </Border>

                            <!-- Word wrap -->
                            <Border BorderThickness="{StaticResource SettingsRowDivider}" BorderBrush="{DynamicResource LineBrush}">
                                <Grid MinHeight="{StaticResource SettingsRowMinHeight}" Margin="{StaticResource SettingsRowPadding}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Word wrap" Style="{DynamicResource BodyLabelText}" Foreground="{DynamicResource TextBrush}" />
                                        <TextBlock Text="Wrap long lines instead of scrolling sideways." Style="{DynamicResource SecondaryText}"
                                                   Foreground="{DynamicResource Text2Brush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <CheckBox x:Name="WordWrapSwitch" Grid.Column="1" Margin="{StaticResource SettingsControlGap}"
                                              VerticalAlignment="Center" Style="{DynamicResource ToggleSwitch}" c:Ui.LabelPlacement="Left"
                                              IsChecked="{Binding WordWrap}"
                                              Content="{Binding IsChecked, RelativeSource={RelativeSource Self}, Converter={x:Static v:BooleanToTextConverter.Instance}, ConverterParameter='On|Off'}"
                                              AutomationProperties.AutomationId="WordWrapSwitch" AutomationProperties.Name="Word wrap"
                                              AutomationProperties.HelpText="Wrap long lines instead of scrolling sideways." />
                                </Grid>
                            </Border>

                            <!-- Line numbers -->
                            <Border BorderThickness="{StaticResource SettingsRowDivider}" BorderBrush="{DynamicResource LineBrush}">
                                <Grid MinHeight="{StaticResource SettingsRowMinHeight}" Margin="{StaticResource SettingsRowPadding}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Line numbers" VerticalAlignment="Center" Style="{DynamicResource BodyLabelText}"
                                               Foreground="{DynamicResource TextBrush}" />
                                    <CheckBox x:Name="LineNumbersSwitch" Grid.Column="1" Margin="{StaticResource SettingsControlGap}"
                                              VerticalAlignment="Center" Style="{DynamicResource ToggleSwitch}" c:Ui.LabelPlacement="Left"
                                              IsChecked="{Binding ShowLineNumbers}"
                                              Content="{Binding IsChecked, RelativeSource={RelativeSource Self}, Converter={x:Static v:BooleanToTextConverter.Instance}, ConverterParameter='On|Off'}"
                                              AutomationProperties.AutomationId="LineNumbersSwitch" AutomationProperties.Name="Line numbers" />
                                </Grid>
                            </Border>

                            <!-- Tab size -->
                            <Border BorderThickness="{StaticResource SettingsRowDivider}" BorderBrush="{DynamicResource LineBrush}">
                                <Grid MinHeight="{StaticResource SettingsRowMinHeight}" Margin="{StaticResource SettingsRowPadding}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Tab size" VerticalAlignment="Center" Style="{DynamicResource BodyLabelText}"
                                               Foreground="{DynamicResource TextBrush}" />
                                    <c:SegmentedControl x:Name="TabSizeSegmented" Grid.Column="1" Margin="{StaticResource SettingsControlGap}"
                                                        VerticalAlignment="Center"
                                                        SelectedValuePath="Tag" SelectedValue="{Binding TabSize}"
                                                        AutomationProperties.AutomationId="TabSizeSegmented" AutomationProperties.Name="Tab size">
                                        <c:SegmentedControlItem Content="2" AutomationProperties.Name="2">
                                            <c:SegmentedControlItem.Tag>
                                                <sys:Int32>2</sys:Int32>
                                            </c:SegmentedControlItem.Tag>
                                        </c:SegmentedControlItem>
                                        <c:SegmentedControlItem Content="4" AutomationProperties.Name="4">
                                            <c:SegmentedControlItem.Tag>
                                                <sys:Int32>4</sys:Int32>
                                            </c:SegmentedControlItem.Tag>
                                        </c:SegmentedControlItem>
                                        <c:SegmentedControlItem Content="8" AutomationProperties.Name="8">
                                            <c:SegmentedControlItem.Tag>
                                                <sys:Int32>8</sys:Int32>
                                            </c:SegmentedControlItem.Tag>
                                        </c:SegmentedControlItem>
                                    </c:SegmentedControl>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ContentControl>
                </StackPanel>

                <!-- ============================================================ General (page 21) -->
                <StackPanel x:Name="GeneralPage"
                            Visibility="{Binding SelectedPage, Converter={x:Static v:VisibleWhenEqualConverter.Instance}, ConverterParameter={x:Static vm:SettingsPage.General}}">
                    <TextBlock Text="General" Style="{DynamicResource PageTitleText}" Foreground="{DynamicResource TextBrush}" />

                    <ContentControl Style="{DynamicResource Card}" Padding="0" Margin="0,16,0,0">
                        <StackPanel>
                            <!-- Start with Windows -->
                            <Grid MinHeight="{StaticResource SettingsRowMinHeight}" Margin="{StaticResource SettingsRowPadding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Start with Windows" Style="{DynamicResource BodyLabelText}" Foreground="{DynamicResource TextBrush}" />
                                    <TextBlock Text="Open NimPad in the background when you sign in to Windows." Style="{DynamicResource SecondaryText}"
                                               Foreground="{DynamicResource Text2Brush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <CheckBox x:Name="StartWithWindowsSwitch" Grid.Column="1" Margin="{StaticResource SettingsControlGap}"
                                          VerticalAlignment="Center" Style="{DynamicResource ToggleSwitch}" c:Ui.LabelPlacement="Left"
                                          IsChecked="{Binding StartWithWindows}"
                                          Content="{Binding IsChecked, RelativeSource={RelativeSource Self}, Converter={x:Static v:BooleanToTextConverter.Instance}, ConverterParameter='On|Off'}"
                                          AutomationProperties.AutomationId="StartWithWindowsSwitch" AutomationProperties.Name="Start with Windows"
                                          AutomationProperties.HelpText="Open NimPad in the background when you sign in to Windows." />
                            </Grid>

                            <!-- Restore previous tabs -->
                            <Border BorderThickness="{StaticResource SettingsRowDivider}" BorderBrush="{DynamicResource LineBrush}">
                                <Grid MinHeight="{StaticResource SettingsRowMinHeight}" Margin="{StaticResource SettingsRowPadding}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Restore previous tabs" Style="{DynamicResource BodyLabelText}" Foreground="{DynamicResource TextBrush}" />
                                        <TextBlock Text="Reopen your tabs, in order, exactly as you left them." Style="{DynamicResource SecondaryText}"
                                                   Foreground="{DynamicResource Text2Brush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <CheckBox x:Name="RestoreTabsSwitch" Grid.Column="1" Margin="{StaticResource SettingsControlGap}"
                                              VerticalAlignment="Center" Style="{DynamicResource ToggleSwitch}" c:Ui.LabelPlacement="Left"
                                              IsChecked="{Binding RestoreTabs}"
                                              Content="{Binding IsChecked, RelativeSource={RelativeSource Self}, Converter={x:Static v:BooleanToTextConverter.Instance}, ConverterParameter='On|Off'}"
                                              AutomationProperties.AutomationId="RestoreTabsSwitch" AutomationProperties.Name="Restore previous tabs"
                                              AutomationProperties.HelpText="Reopen your tabs, in order, exactly as you left them." />
                                </Grid>
                            </Border>

                            <!-- Global shortcut: Change captures the next chord with a modifier; Esc cancels. -->
                            <Border BorderThickness="{StaticResource SettingsRowDivider}" BorderBrush="{DynamicResource LineBrush}">
                                <Grid MinHeight="{StaticResource SettingsRowMinHeight}" Margin="{StaticResource SettingsRowPadding}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Global shortcut" Style="{DynamicResource BodyLabelText}" Foreground="{DynamicResource TextBrush}" />
                                        <TextBlock Text="Open NimPad from anywhere in Windows." Style="{DynamicResource SecondaryText}"
                                                   Foreground="{DynamicResource Text2Brush}" TextWrapping="Wrap" />
                                        <DockPanel Margin="0,6,0,0"
                                                   Visibility="{Binding ShortcutError, Converter={x:Static v:VisibleWhenConverter.Instance}}">
                                            <c:Icon DockPanel.Dock="Left" Margin="0,1,6,0" VerticalAlignment="Top"
                                                    Data="{DynamicResource ErrorCircle}" Foreground="{DynamicResource ErrBrush}" />
                                            <TextBlock x:Name="ShortcutErrorText" Text="{Binding ShortcutError}" TextWrapping="Wrap"
                                                       Style="{DynamicResource SecondaryText}" Foreground="{DynamicResource ErrBrush}"
                                                       AutomationProperties.AutomationId="GlobalShortcutError"
                                                       AutomationProperties.LiveSetting="Assertive" />
                                        </DockPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="{StaticResource SettingsControlGap}" Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <c:ShortcutKeys x:Name="GlobalShortcutKeys" VerticalAlignment="Center" Gesture="{Binding GlobalShortcut}"
                                                        Visibility="{Binding IsCapturingShortcut, Converter={x:Static v:VisibleWhenConverter.Instance}, ConverterParameter=Invert}"
                                                        AutomationProperties.AutomationId="GlobalShortcutKeys" />
                                        <TextBlock x:Name="CaptureHint" VerticalAlignment="Center" Text="Press the new shortcut"
                                                   Style="{DynamicResource SecondaryText}" Foreground="{DynamicResource AccentBrush}"
                                                   Visibility="{Binding IsCapturingShortcut, Converter={x:Static v:VisibleWhenConverter.Instance}}"
                                                   AutomationProperties.LiveSetting="Polite" />
                                        <Button x:Name="ChangeShortcutButton" Margin="12,0,0,0" Style="{DynamicResource SecondaryButton}"
                                                Content="{Binding IsCapturingShortcut, Converter={x:Static v:BooleanToTextConverter.Instance}, ConverterParameter='Cancel|Change'}"
                                                AutomationProperties.Name="{Binding IsCapturingShortcut, Converter={x:Static v:BooleanToTextConverter.Instance}, ConverterParameter='Cancel the new shortcut|Change global shortcut'}"
                                                AutomationProperties.AutomationId="GlobalShortcutChange"
                                                Click="OnChangeShortcutClick" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ContentControl>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
