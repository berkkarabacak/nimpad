<!--
    Title bar (deck p-04, p-24, p-28): app mark + "NimPad" (hidden in the medium and narrow layouts), the tab strip with
    the new-note button right after the last tab, the account slot (hidden in Phase 1) and the window controls.
    Everything that is not a control is the WindowChrome caption: it drags the window, double-click maximizes; a
    right-click on the empty tab-bar space opens the tab-bar menu (MainWindow handles WM_NCRBUTTONUP), on the app mark
    the system menu. DataContext = ShellViewModel.
    Only DynamicResource for design-system keys; StaticResource only for keys defined earlier in this file.
-->
<UserControl x:Class="NimPad.App.Shell.TitleBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:NimPad.App.Controls"
             xmlns:shell="clr-namespace:NimPad.App.Shell"
             xmlns:chrome="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             AutomationProperties.AutomationId="TitleBar"
             AutomationProperties.Name="Title bar"
             KeyboardNavigation.TabNavigation="Cycle"
             Height="40">
    <UserControl.Resources>

        <!-- Right-click on empty tab-bar space and on the new-note button (deck p-25). -->
        <ContextMenu x:Key="TabBarMenu" AutomationProperties.AutomationId="TabBarMenu">
            <MenuItem Header="New note" InputGestureText="Ctrl+N" c:Ui.Icon="{DynamicResource Plus}"
                      Command="{Binding NewNoteCommand}" AutomationProperties.AutomationId="TabBarMenuNewNote" />
            <MenuItem Header="Reopen closed tab" InputGestureText="Ctrl+Shift+T" c:Ui.Icon="{DynamicResource Restore}"
                      Command="{Binding ReopenClosedTabCommand}" IsEnabled="{Binding Tabs.CanReopenClosedTab}"
                      AutomationProperties.AutomationId="TabBarMenuReopen" />
        </ContextMenu>

        <!-- The tab menu (deck p-10). DataContext = the TabViewModel; PlacementTarget.Tag = the TabsViewModel. -->
        <ContextMenu x:Key="TabMenu" x:Shared="False" AutomationProperties.AutomationId="TabMenu">
            <MenuItem Header="Rename" InputGestureText="F2" c:Ui.Icon="{DynamicResource Rename}"
                      AutomationProperties.AutomationId="TabMenuRename"
                      CommandParameter="{Binding}"
                      Command="{Binding PlacementTarget.Tag.RenameTabCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Duplicate" InputGestureText="Ctrl+Shift+D" c:Ui.Icon="{DynamicResource Copy}"
                      AutomationProperties.AutomationId="TabMenuDuplicate"
                      CommandParameter="{Binding}"
                      Command="{Binding PlacementTarget.Tag.DuplicateTabCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Pin tab" c:Ui.Icon="{DynamicResource Pin}" AutomationProperties.AutomationId="TabMenuPin"
                      Visibility="{Binding IsPinned, Converter={x:Static shell:ShellConverters.FalseToVisible}}"
                      CommandParameter="{Binding}"
                      Command="{Binding PlacementTarget.Tag.TogglePinCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Unpin tab" c:Ui.Icon="{DynamicResource Unpin}" AutomationProperties.AutomationId="TabMenuUnpin"
                      Visibility="{Binding IsPinned, Converter={x:Static shell:ShellConverters.TrueToVisible}}"
                      CommandParameter="{Binding}"
                      Command="{Binding PlacementTarget.Tag.TogglePinCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <Separator />
            <MenuItem Header="Close" InputGestureText="Ctrl+W" c:Ui.Icon="{DynamicResource Close}"
                      AutomationProperties.AutomationId="TabMenuClose"
                      CommandParameter="{Binding}"
                      Command="{Binding PlacementTarget.Tag.CloseTabCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Close others" c:Ui.Icon="{DynamicResource Close}"
                      AutomationProperties.AutomationId="TabMenuCloseOthers"
                      CommandParameter="{Binding}"
                      Command="{Binding PlacementTarget.Tag.CloseOtherTabsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Close tabs to the right"
                      AutomationProperties.AutomationId="TabMenuCloseRight"
                      CommandParameter="{Binding}"
                      Command="{Binding PlacementTarget.Tag.CloseTabsToTheRightCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        </ContextMenu>

        <!--
            One tab (deck p-24): 34 px, 96-172 wide (104 pinned), top corners 8. Text-2 title; hover wash + close;
            selected = Surface (shared with the editor) + 500 weight + close; inset focus ring; pinned = pin icon, no
            close; waiting to save = accent dot instead of the close icon (close on hover); save failed = Err dot;
            loading = muted title (+ spinner after 600 ms); renaming = inline box; dragging = lifted card.
        -->
        <Style x:Key="TabItemStyle" TargetType="shell:TabStripItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
            <Setter Property="Padding" Value="16,0,8,0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource InsetFocusVisual}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="chrome:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
            <Setter Property="AutomationProperties.HelpText" Value="{Binding ToolTip}" />
            <Setter Property="AutomationProperties.ItemStatus">
                <Setter.Value>
                    <MultiBinding Converter="{x:Static shell:ShellConverters.TabItemStatus}">
                        <Binding Path="SaveState" />
                        <Binding Path="IsDirty" />
                    </MultiBinding>
                </Setter.Value>
            </Setter>
            <Setter Property="ToolTip" Value="{Binding ToolTip}" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="700" />
            <Setter Property="Tag" Value="{Binding DataContext.Tabs, RelativeSource={RelativeSource AncestorType=shell:TabStrip}}" />
            <Setter Property="IsPinnedTab" Value="{Binding IsPinned}" />
            <Setter Property="IsRenamingTab" Value="{Binding IsRenaming}" />
            <Setter Property="ContextMenu" Value="{DynamicResource TabMenu}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="shell:TabStripItem">
                        <Grid x:Name="Root" Background="Transparent" SnapsToDevicePixels="True">
                            <Border x:Name="Fill" Background="{TemplateBinding Background}"
                                    CornerRadius="{DynamicResource TabTopRadius}" />
                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <c:Icon x:Name="PinGlyph" Data="{DynamicResource Pin}" Size="14" Margin="0,0,6,0"
                                        VerticalAlignment="Center" Visibility="Collapsed"
                                        Foreground="{DynamicResource Text2Brush}" />
                                <TextBlock x:Name="TitleText" Grid.Column="1" Text="{Binding Title}"
                                           Style="{DynamicResource TabText}" Foreground="{DynamicResource Text2Brush}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBox x:Name="PART_RenameBox" Grid.Column="1" Grid.ColumnSpan="2" Visibility="Collapsed"
                                         MinHeight="24" Padding="6,0" FontSize="13" VerticalAlignment="Center"
                                         chrome:WindowChrome.IsHitTestVisibleInChrome="True"
                                         Text="{Binding RenameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         c:Ui.HasError="{Binding RenameError, Converter={x:Static shell:ShellConverters.NotEmpty}}"
                                         AutomationProperties.Name="Tab name"
                                         AutomationProperties.HelpText="{Binding RenameError}"
                                         AutomationProperties.AutomationId="TabRenameBox">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding CommitRenameCommand}" />
                                        <KeyBinding Key="Escape" Command="{Binding CancelRenameCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                                <Grid x:Name="Trailing" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <Grid x:Name="DotHost" Width="20" Height="20" Visibility="Collapsed">
                                        <Ellipse x:Name="Dot" Width="6" Height="6" Fill="{DynamicResource AccentBrush}" />
                                    </Grid>
                                    <Grid x:Name="BusyHost" Width="20" Height="20" Visibility="Collapsed">
                                        <c:Spinner Size="14" />
                                    </Grid>
                                    <Button x:Name="PART_CloseButton" Style="{DynamicResource SmallIconButton}"
                                            c:Ui.Icon="{DynamicResource Close}" Visibility="Hidden"
                                            Focusable="False" IsTabStop="False"
                                            chrome:WindowChrome.IsHitTestVisibleInChrome="True"
                                            ToolTip="Close (Ctrl+W)" AutomationProperties.Name="Close tab"
                                            AutomationProperties.AutomationId="{Binding Index, RelativeSource={RelativeSource TemplatedParent}, StringFormat=TabClose_{0}}"
                                            CommandParameter="{Binding}"
                                            Command="{Binding Tag.CloseTabCommand, RelativeSource={RelativeSource TemplatedParent}}" />
                                </Grid>
                            </Grid>
                            <Border x:Name="Separator" Style="{DynamicResource VerticalDivider}" HorizontalAlignment="Right"
                                    Visibility="Collapsed" />
                            <Popup x:Name="RenameErrorPopup" PlacementTarget="{Binding ElementName=PART_RenameBox}"
                                   Placement="Bottom" VerticalOffset="4" AllowsTransparency="True" Focusable="False"
                                   StaysOpen="True">
                                <Popup.IsOpen>
                                    <MultiBinding Converter="{x:Static shell:ShellConverters.AllTrue}" Mode="OneWay">
                                        <Binding Path="IsRenaming" />
                                        <Binding Path="RenameError" Converter="{x:Static shell:ShellConverters.NotEmpty}" />
                                    </MultiBinding>
                                </Popup.IsOpen>
                                <Border Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource LineBrush}"
                                        BorderThickness="1" CornerRadius="{DynamicResource Radius6}" Padding="8,4"
                                        MaxWidth="320">
                                    <DockPanel>
                                        <c:Icon Data="{DynamicResource ErrorCircle}" Size="14" Margin="0,1,6,0"
                                                VerticalAlignment="Top" Foreground="{DynamicResource ErrBrush}" />
                                        <TextBlock Style="{DynamicResource CaptionText}" Foreground="{DynamicResource ErrBrush}"
                                                   TextWrapping="Wrap" Text="{Binding RenameError}" />
                                    </DockPanel>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="ShowSeparator" Value="True">
                                <Setter TargetName="Separator" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                <Setter TargetName="TitleText" Property="FontWeight" Value="Medium" />
                                <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource TextBrush}" />
                                <Setter TargetName="PinGlyph" Property="Foreground" Value="{DynamicResource TextBrush}" />
                                <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource Text3Brush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsLoadingSpinnerVisible}" Value="True">
                                <Setter TargetName="BusyHost" Property="Visibility" Value="Visible" />
                                <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Hidden" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SaveState}" Value="Pending">
                                <Setter TargetName="DotHost" Property="Visibility" Value="Visible" />
                                <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Hidden" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SaveState}" Value="Failed">
                                <Setter TargetName="DotHost" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource ErrBrush}" />
                                <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Hidden" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DotHost" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="BusyHost" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsPinnedTab" Value="True">
                                <Setter TargetName="PinGlyph" Property="Visibility" Value="Visible" />
                                <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsPinnedTab" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Trailing" Property="Visibility" Value="Collapsed" />
                            </MultiTrigger>
                            <Trigger Property="IsRenamingTab" Value="True">
                                <Setter TargetName="TitleText" Property="Visibility" Value="Hidden" />
                                <Setter TargetName="Trailing" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="PART_RenameBox" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsDragSource" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource RaisedBrush}" />
                                <Setter TargetName="Fill" Property="CornerRadius" Value="{DynamicResource Radius8}" />
                                <Setter TargetName="Fill" Property="Effect" Value="{DynamicResource FlyoutShadow}" />
                                <Setter TargetName="Separator" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The strip: chevrons (when the tabs overflow), the tabs and the drop marker. -->
        <Style x:Key="TabStripStyle" TargetType="shell:TabStrip">
            <Setter Property="Background" Value="{x:Null}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource TabItemStyle}" />
            <Setter Property="chrome:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="False" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <shell:TabStripPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="shell:TabStrip">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PART_ScrollLeft" Style="{DynamicResource SmallIconButton}"
                                    c:Ui.Icon="{DynamicResource ChevronLeft}" Margin="0,6,2,0" VerticalAlignment="Center"
                                    Focusable="False" IsTabStop="False" Visibility="Collapsed"
                                    chrome:WindowChrome.IsHitTestVisibleInChrome="True"
                                    ToolTip="Scroll tabs left" AutomationProperties.Name="Scroll tabs left"
                                    AutomationProperties.AutomationId="TabScrollLeft" />
                            <ScrollViewer x:Name="PART_ScrollViewer" Grid.Column="1" Focusable="False" Padding="0"
                                          CanContentScroll="False" HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly">
                                <Grid>
                                    <ItemsPresenter />
                                    <Canvas IsHitTestVisible="False">
                                        <Rectangle x:Name="PART_DropMarker" Width="2" Height="24" Canvas.Top="11"
                                                   RadiusX="1" RadiusY="1" Fill="{DynamicResource AccentBrush}"
                                                   Visibility="Collapsed" />
                                    </Canvas>
                                </Grid>
                            </ScrollViewer>
                            <Button x:Name="PART_ScrollRight" Grid.Column="2" Style="{DynamicResource SmallIconButton}"
                                    c:Ui.Icon="{DynamicResource ChevronRight}" Margin="2,6,0,0" VerticalAlignment="Center"
                                    Focusable="False" IsTabStop="False" Visibility="Collapsed"
                                    chrome:WindowChrome.IsHitTestVisibleInChrome="True"
                                    ToolTip="Scroll tabs right" AutomationProperties.Name="Scroll tabs right"
                                    AutomationProperties.AutomationId="TabScrollRight" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsOverflowing" Value="True">
                                <Setter TargetName="PART_ScrollLeft" Property="Visibility" Value="Visible" />
                                <Setter TargetName="PART_ScrollRight" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- "NimPad" next to the app mark: 12 / 600, Text2, dimmed while the window is inactive. -->
        <Style x:Key="AppNameText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
            <Style.Triggers>
                <Trigger Property="c:Ui.IsWindowActive" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource Text3Brush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Root" Background="{DynamicResource ChromeBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- App mark: part of the drag area. -->
        <StackPanel x:Name="AppMarkArea" Orientation="Horizontal" Margin="16,0,8,0" VerticalAlignment="Center">
            <Image x:Name="AppMark" Source="{DynamicResource AppMarkImage}" Width="18" Height="18"
                   VerticalAlignment="Center" AutomationProperties.Name="NimPad" />
            <TextBlock x:Name="AppName" Text="NimPad" Style="{StaticResource AppNameText}" Margin="10,0,0,0"
                       VerticalAlignment="Center" AutomationProperties.AutomationId="AppName"
                       Visibility="{Binding ShowAppName, Converter={x:Static shell:ShellConverters.TrueToVisible}}" />
        </StackPanel>

        <!-- Tabs, then the new-note button; the rest of the column is drag area. -->
        <shell:TitleTabsLayout x:Name="TabArea" Grid.Column="1">
            <shell:TabStrip x:Name="Tabs" Style="{StaticResource TabStripStyle}"
                            ItemsSource="{Binding Tabs.Tabs}"
                            SelectedItem="{Binding Tabs.SelectedTab, Mode=TwoWay}"
                            AutomationProperties.AutomationId="TabStrip"
                            AutomationProperties.Name="Open notes" />
            <Button x:Name="NewTabButton" Style="{DynamicResource NewTabButton}"
                    Command="{Binding NewNoteCommand}" ContextMenu="{StaticResource TabBarMenu}"
                    ToolTip="New note (Ctrl+N)" AutomationProperties.Name="New note"
                    AutomationProperties.AutomationId="NewTabButton" />
        </shell:TitleTabsLayout>

        <!-- Account (deck p-24): hidden until sign-in exists (Phase 2). -->
        <Border x:Name="AccountSlot" Grid.Column="2" Width="{DynamicResource AvatarSize}" Margin="8,0" Visibility="Collapsed" />

        <StackPanel x:Name="WindowControls" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top">
            <Button x:Name="MinimizeButton" Style="{DynamicResource TitleBarButton}" c:Ui.Icon="{DynamicResource Minimize}"
                    ToolTip="Minimize" AutomationProperties.Name="Minimize"
                    AutomationProperties.AutomationId="MinimizeButton" Click="OnMinimizeClick" />
            <Button x:Name="MaximizeButton" Style="{DynamicResource TitleBarButton}" c:Ui.Icon="{DynamicResource Maximize}"
                    ToolTip="Maximize" AutomationProperties.Name="Maximize"
                    AutomationProperties.AutomationId="MaximizeButton" Click="OnMaximizeClick" />
            <Button x:Name="CloseButton" Style="{DynamicResource CloseTitleBarButton}"
                    ToolTip="Close" AutomationProperties.Name="Close"
                    AutomationProperties.AutomationId="CloseButton" Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</UserControl>
