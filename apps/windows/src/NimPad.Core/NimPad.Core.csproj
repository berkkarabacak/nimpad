<Project Sdk="Microsoft.NET.Sdk">
  <!-- Domain model, local SQLite storage, services and the pending-operation queue. Cross-platform. -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>
  <ItemGroup>
    <!-- Local schema migrations, applied in file-name order (see Storage/SchemaMigrations.cs). -->
    <EmbeddedResource Include="Storage\Migrations\*.sql" LogicalName="NimPad.Core.Migrations.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="NimPad.Core.Tests" />
  </ItemGroup>
</Project>
