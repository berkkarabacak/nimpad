<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows-only end-to-end UI tests driven through UI Automation (FlaUI). See ../README.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- DPI aware, so UI Automation coordinates and mouse input agree on scaled displays. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="FlaUI.Core" />
    <PackageReference Include="FlaUI.UIA3" />
  </ItemGroup>
</Project>
