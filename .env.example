# Copy to .env and adjust. Never commit real secrets.

# --- Database -------------------------------------------------------------
# Connection used by the API/worker at runtime. Must be a NON-owner role
# without BYPASSRLS (created by the migrations as `nimpad_app`).
DATABASE_URL=postgres://nimpad_app:nimpad_app@127.0.0.1:5432/nimpad
# Connection used by `pnpm db:migrate` (schema owner).
DATABASE_URL_MIGRATE=postgres://nimpad:nimpad@127.0.0.1:5432/nimpad
# Dev only: `pnpm db:migrate` gives the nimpad_app role LOGIN with this password. It refuses any database that is not
# on this machine unless NIMPAD_ALLOW_REMOTE_DEV_PASSWORD=1 is also set (never do that for a shared database).
NIMPAD_APP_DB_PASSWORD=nimpad_app
# NIMPAD_ALLOW_REMOTE_DEV_PASSWORD=

# --- API ------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8787
LOG_LEVEL=info
# Largest accepted request body, in bytes (default 1 MiB).
BODY_LIMIT_BYTES=1048576

# --- Worker -----------------------------------------------------------------
WORKER_POLL_INTERVAL_MS=1000
WORKER_SHUTDOWN_TIMEOUT_MS=30000

# --- Tests ------------------------------------------------------------------
# Database used by the API's integration tests, and the admin connection the database tests use to create and
# drop their own throwaway databases.
DATABASE_URL_TEST=postgres://nimpad:nimpad@127.0.0.1:5432/nimpad
DATABASE_URL_ADMIN=postgres://nimpad:nimpad@127.0.0.1:5432/postgres
# Set to 1 to make database tests fail (instead of skip) when PostgreSQL is unreachable. CI sets it.
# NIMPAD_REQUIRE_DB=1

# --- MCP server -------------------------------------------------------------
# Reserved for the remote HTTPS endpoint (Phase 4). Today the MCP server only runs as a local STDIO adapter.
MCP_HOST=127.0.0.1
MCP_PORT=8788

# --- Supabase / Google (Phase 2; placeholders only) --------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
# JWKS endpoint used to verify Supabase access tokens (asymmetric keys).
SUPABASE_JWKS_URL=
GOOGLE_CLIENT_ID=
