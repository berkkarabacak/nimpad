{
  "name": "nimpad",
  "private": true,
  "description": "NimPad monorepo: Windows desktop app, cloud API, MCP server and worker.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "lint": "biome ci .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "db:up": "docker compose up -d db",
    "db:migrate": "pnpm --filter @nimpad/database migrate",
    "dev:api": "pnpm --filter @nimpad/api dev",
    "dev:mcp": "pnpm --filter @nimpad/mcp dev",
    "dev:worker": "pnpm --filter @nimpad/worker dev"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}
