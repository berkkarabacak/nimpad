{
  "name": "@nimpad/database",
  "version": "0.1.0",
  "private": true,
  "description": "PostgreSQL schema migrations and the migration runner.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "migrate": "node --env-file-if-exists=../.env src/cli.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}
